---
permalink: ../../sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  
  {# ================================================================ #}
  {# STATIC PAGES - one entry per page, emitted for both languages     #}
  {# ================================================================ #}
  {#
    Each page is listed once with its English and Spanish paths; the loop
    writes one <url> per language, each carrying the full hreflang set.
    The homepage uses "/" and "/es/" (its canonical URLs), not index.html.

    No <lastmod> here, deliberately: these pages have no reliable
    modification date (the old value was the sitemap template's own file
    date, frozen in 2025), and Google ignores lastmod once it proves
    inaccurate. Blog posts below keep theirs, since a post's date is real.
  #}
  {% set staticPages = [
    { en: "/", es: "/es/", changefreq: "weekly", priority: "1.0" },
    { en: "/about.html", es: "/es/about.html", changefreq: "monthly", priority: "0.8" },
    { en: "/classes.html", es: "/es/classes.html", changefreq: "weekly", priority: "0.9" },
    { en: "/events.html", es: "/es/events.html", changefreq: "weekly", priority: "0.9" },
    { en: "/certifications/aerial-yoga-100.html", es: "/es/certifications/aerial-yoga-100.html", changefreq: "monthly", priority: "0.9" },
    { en: "/blog/dist/", es: "/blog/dist/es/", changefreq: "weekly", priority: "0.7" }
  ] %}
  {% for staticPage in staticPages %}
  {% for lang in ["en", "es"] %}
  <url>
    <loc>https://sgpyoga.co{{ staticPage[lang] }}</loc>
    <xhtml:link rel="alternate" hreflang="en" href="https://sgpyoga.co{{ staticPage.en }}"/>
    <xhtml:link rel="alternate" hreflang="es" href="https://sgpyoga.co{{ staticPage.es }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://sgpyoga.co{{ staticPage.en }}"/>
    <changefreq>{{ staticPage.changefreq }}</changefreq>
    <priority>{{ staticPage.priority }}</priority>
  </url>
  {% endfor %}
  {% endfor %}

  {# ================================================================ #}
  {# BLOG POSTS - Dynamically Generated #}
  {# ================================================================ #}
  
  {# English Blog Posts #}
  {% for post in collections.postsEN %}
  <url>
    <loc>https://sgpyoga.co/blog/dist{{ post.url }}</loc>
    {# Find Spanish equivalent if exists #}
    {% set spanishPost = collections.postsES | findByFileSlug(post.fileSlug) %}
    <xhtml:link rel="alternate" hreflang="en" href="https://sgpyoga.co/blog/dist{{ post.url }}"/>
    {% if spanishPost %}
    <xhtml:link rel="alternate" hreflang="es" href="https://sgpyoga.co/blog/dist{{ spanishPost.url }}"/>
    {% endif %}
    <xhtml:link rel="alternate" hreflang="x-default" href="https://sgpyoga.co/blog/dist{{ post.url }}"/>
    <lastmod>{{ post.date | htmlDateString }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {% endfor %}
  
  {# Spanish Blog Posts #}
  {% for post in collections.postsES %}
  <url>
    <loc>https://sgpyoga.co/blog/dist{{ post.url }}</loc>
    {# Find English equivalent if exists #}
    {% set englishPost = collections.postsEN | findByFileSlug(post.fileSlug) %}
    {% if englishPost %}
    <xhtml:link rel="alternate" hreflang="en" href="https://sgpyoga.co/blog/dist{{ englishPost.url }}"/>
    {% endif %}
    <xhtml:link rel="alternate" hreflang="es" href="https://sgpyoga.co/blog/dist{{ post.url }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://sgpyoga.co/blog/dist{{ englishPost.url if englishPost else post.url }}"/>
    <lastmod>{{ post.date | htmlDateString }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {% endfor %}
  
</urlset>
