# Credentials for `npm run build:content`, which fetches the class schedule and
# events from Supabase at build time. Copy to `.env` (gitignored) for local builds;
# on Netlify, set the same two variables in the site's environment settings.
#
# The publishable key is correct here and not a compromise: the school tables are
# public by policy, and public-read RLS is what hides retired classes and
# unpublished events. Never use the secret key — it bypasses RLS and would publish
# drafts.
#
# Local stack (platform/: `npm run db:start`) — values printed by `supabase status`:
#   SUPABASE_URL=http://127.0.0.1:54321
# Hosted project — Supabase dashboard → Project Settings → API:
#   SUPABASE_URL=https://<project-ref>.supabase.co

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
